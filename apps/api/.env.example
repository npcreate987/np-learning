DATABASE_URL="postgresql://learn:learn@localhost:5433/learn?schema=public"

# Required for Supabase Auth (JWKS / ES256). Set DEV_AUTH=false when going live.
DEV_AUTH=false
SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_JWT_SECRET="..."   # only for legacy HS256 tokens

API_PORT=4000
WEB_ORIGIN="http://localhost:3100,http://localhost:3000"

# Cloudflare R2 (file uploads)
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key"
R2_SECRET_ACCESS_KEY="your-secret-key"
R2_BUCKET="learn-assets"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# AI Tutor (Google Gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"
