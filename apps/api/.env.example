DATABASE_URL="postgresql://learn:learn@localhost:5433/learn?schema=public"

# Required for Supabase Auth (JWKS / ES256). Set DEV_AUTH=false when going live.
DEV_AUTH=false
SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_JWT_SECRET="..."   # only for legacy HS256 tokens

API_PORT=4000
WEB_ORIGIN="http://localhost:3100,http://localhost:3000"

# Object storage for file uploads (S3-compatible). Two options — pick one.
#
# 1) Supabase Storage (recommended, reuses your Supabase project):
#    Dashboard → Storage → Configuration → S3 → enable + generate access keys.
#    Also create a PUBLIC bucket named "learn-assets".
S3_ENDPOINT="https://your-project-ref.storage.supabase.co/storage/v1/s3"
S3_REGION="ap-southeast-1"
S3_BUCKET="learn-assets"
S3_PUBLIC_URL="https://your-project-ref.supabase.co/storage/v1/object/public/learn-assets"
S3_FORCE_PATH_STYLE="true"
S3_ACCESS_KEY_ID="your-s3-access-key-id"
S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"
#
# 2) Cloudflare R2 (alternative) — S3_* above takes precedence if both are set.
# R2_ACCOUNT_ID="your-account-id"
# R2_ACCESS_KEY_ID="your-access-key"
# R2_SECRET_ACCESS_KEY="your-secret-key"
# R2_BUCKET="learn-assets"
# R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# AI Tutor (Google Gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"
