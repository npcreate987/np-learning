# ---------------------------------------------------------------------------
# Root reference for environment variables.
# Copy the relevant blocks into apps/api/.env and apps/web/.env.local
# ---------------------------------------------------------------------------

# ============ apps/api (.env) ============
# PostgreSQL connection string (dev: docker-compose service below)
DATABASE_URL="postgresql://learn:learn@localhost:5432/learn?schema=public"

# Supabase: ใช้ JWT secret ตรวจ token จากฝั่ง client
# Settings > API > JWT Secret ใน Supabase dashboard
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
# (ออปชัน) ใช้ตอน sync ข้อมูล user ฝั่ง server
SUPABASE_URL="https://your-project.supabase.co"

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key"
R2_SECRET_ACCESS_KEY="your-secret-key"
R2_BUCKET="learn-assets"
# public base url ของ bucket (custom domain หรือ r2.dev)
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# API server
API_PORT=4000
# CORS origin ของ web
WEB_ORIGIN="http://localhost:3000"

# AI Tutor (Google Gemini 2.5 Flash) — https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"

# ============ apps/web (.env.local) ============
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
NEXT_PUBLIC_API_URL="http://localhost:4000"
